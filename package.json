{
  "name": "sharepad",
  "version": "4.0.0",
  "private": true,
  "description": "SharePad is a modern markdown-first shared notepad built with Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run sentry:sourcemaps",
    "start": "next start",
    "lint": "next lint",
    "test": "echo \"No tests configured yet\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org pratham-jaiswal --project sharepad ./.next/ && sentry-cli sourcemaps upload --org pratham-jaiswal --project sharepad ./.next/"
  },
  "author": "Pratham Jaiswal (MaxxDevs)",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@mdxeditor/editor": "^4.2.0",
    "@sentry/cli": "^3.6.2",
    "@sentry/nextjs": "^10.69.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "modern-screenshot": "^4.7.0",
    "mongoose": "^9.9.1",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.6",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.0"
  }
}